{
  // Cloudflare Workers 静的サイト設定（sanei-barrel.jp）
  "name": "sanei-site",
  "main": "_worker.js",
  "compatibility_date": "2026-10-17",
  // 本番ドメイン（Workers のカスタムドメイン。DNS レコードは Cloudflare が自動で作る）
  "routes": [
    { "pattern": "sanei-barrel.jp", "custom_domain": true },
    { "pattern": "www.sanei-barrel.jp", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
